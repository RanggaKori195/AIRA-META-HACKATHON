{
  "name": "aira-hackathon",
  "version": "0.5.0",
  "description": "AIRA - AI Lab Assistant (desktop agent on Meta Muse models)",
  "main": "./out/main/index.js",
  "author": "AIRA",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rilis:siapkan": "node scripts/siapkan-rilis.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts",
    "dist": "electron-vite build && npm run build:bytecode && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "build:bytecode": "node scripts/run-bytenode.cjs",
    "dist:debug": "electron-vite build && electron-builder --win",
    "coba:pdf": "esbuild src/main/pdf/render.ts --bundle --platform=node --format=cjs --external:electron --outfile=scripts/.pdf-bundle.cjs && electron scripts/coba-pdf.cjs",
    "buat:ikon": "esbuild src/main/ppt/ikon.ts --bundle --platform=node --format=cjs --outfile=scripts/.ikon-bundle.cjs && electron scripts/buat-ikon.cjs",
    "coba:ppt": "esbuild scripts/coba-ppt.ts --bundle --platform=node --format=cjs --external:electron --outfile=scripts/.ppt-bundle.cjs && electron scripts/.ppt-bundle.cjs",
    "coba:uji": "esbuild scripts/coba-uji.ts --bundle --platform=node --format=cjs --external:electron --outfile=scripts/.uji-bundle.cjs && electron scripts/.uji-bundle.cjs",
    "coba:browser": "esbuild scripts/coba-browser.ts --bundle --platform=node --format=cjs --external:electron --outfile=scripts/.browser-bundle.cjs && electron scripts/.browser-bundle.cjs",
    "coba:grafik": "esbuild scripts/coba-grafik.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.grafik-bundle.cjs && electron scripts/.grafik-bundle.cjs",
    "coba:gambar": "esbuild scripts/coba-gambar.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.gambar-bundle.cjs && electron scripts/.gambar-bundle.cjs",
    "coba:simbol": "esbuild scripts/coba-simbol.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.simbol-bundle.cjs && electron scripts/.simbol-bundle.cjs",
    "coba:onedrive": "esbuild scripts/coba-onedrive.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.onedrive-bundle.cjs && electron scripts/.onedrive-bundle.cjs",
    "seed:dummy": "tsx scripts/seed-dummy.ts",
    "smoke:tools": "esbuild scripts/smoke-tools.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.smoke-bundle.cjs && electron scripts/.smoke-bundle.cjs",
    "mascot:cut": "esbuild scripts/mascot-cut.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.mascot-bundle.cjs && electron scripts/.mascot-bundle.cjs",
    "ppt:theme": "esbuild scripts/ppt-theme.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/.ppttheme-bundle.cjs && electron scripts/.ppttheme-bundle.cjs",
    "scrub:check": "tsx scripts/scrub-check.ts",
    "seed:reagent": "tsx scripts/seed-reagent.ts",
    "scrub:public": "tsx scripts/scrub-check.ts --public"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "better-sqlite3": "^12.2.0",
    "bytenode": "^1.6.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pptxgenjs": "^4.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "lucide-static": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}

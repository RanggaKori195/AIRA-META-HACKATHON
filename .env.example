# Copy this file to .env and fill in the keys. Keys are read at build time (npm run dev / npm run dist).
# Never commit .env or .env.local — both are git-ignored.

# --- Meta Muse (required): the brain — answers, tools, voice transcription, images ---
AIRA_API_KEY=
AIRA_ENDPOINT=https://api.meta.ai
AIRA_MODEL=muse-wonder-1.0

# --- ElevenLabs (optional): AIRA's voice. Empty = the Windows voice is used instead ---
# May also go in .env.local. The demo-video scripts (video/) read it from ../.env.local.
ELEVENLABS_API_KEY=
# Optional: another ElevenLabs voice id (default: Sarah)
ELEVENLABS_VOICE_ID=

# --- Web search (optional): the "Trend" line of the morning briefing and the web_search tool ---
AIRA_YOU_API_KEY=
AIRA_EXA_API_KEY=

# --- Local PostgreSQL only (the build refuses any other host). Fill it with: npm run seed:dummy ---
AIRA_SALES_DB=postgresql://postgres:password@localhost:5432/metahackton
AIRA_LOGIN_DB=postgresql://postgres:password@localhost:5432/metahackton
AIRA_INNO_DB=postgresql://postgres:password@localhost:5432/metahackton

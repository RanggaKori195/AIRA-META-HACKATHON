# Copy to .env. Keys are read at build time; never commit .env.
AIRA_API_KEY=
AIRA_ENDPOINT=https://api.meta.ai
AIRA_MODEL=muse-wonder-1.0
# Local PostgreSQL only (the build refuses any other host).
AIRA_SALES_DB=postgresql://postgres:password@localhost:5432/metahackton
AIRA_LOGIN_DB=postgresql://postgres:password@localhost:5432/metahackton
AIRA_INNO_DB=postgresql://postgres:password@localhost:5432/metahackton
# Optional web search keys
AIRA_YOU_API_KEY=
AIRA_EXA_API_KEY=
